{
  "env": {
    "SUPERPOWERS_DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npx -y modern-web-guidance@latest:*)",
      "Bash(pnpx modern-web-guidance@latest:*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh busy",
            "async": true,
            "statusMessage": "tab status: busy"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh busy",
            "async": true,
            "statusMessage": "tab status: busy"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh busy",
            "async": true,
            "statusMessage": "tab status: busy"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh busy",
            "async": true,
            "statusMessage": "tab status: busy"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh done",
            "async": true,
            "statusMessage": "tab status: done"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh done",
            "async": true,
            "statusMessage": "tab status: done"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh reset",
            "statusMessage": "tab status: reset"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh reset",
            "statusMessage": "tab status: reset"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh waiting",
            "statusMessage": "tab status: waiting"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh waiting",
            "statusMessage": "tab status: waiting"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh reset",
            "statusMessage": "tab status: reset"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh reset",
            "statusMessage": "tab status: reset"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh reset",
            "statusMessage": "tab status: reset"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh reset",
            "statusMessage": "tab status: reset"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/prisma-prod-guard",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude-personal/statusline.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "next-steps@claude-community": true,
    "figma@claude-plugins-official": true,
    "modern-web-guidance@googlechrome": true,
    "atlassian@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "footerLinksRegexes": [
    {
      "type": "regex",
      "pattern": "http://localhost:3000\\b",
      "url": "http://localhost:3000",
      "label": "localhost:3000"
    },
    {
      "type": "regex",
      "pattern": "http://localhost:3001\\b",
      "url": "http://localhost:3001",
      "label": "localhost:3001"
    },
    {
      "type": "regex",
      "pattern": "http://localhost:3020\\b",
      "url": "http://localhost:3020",
      "label": "localhost:3020"
    },
    {
      "type": "regex",
      "pattern": "http://localhost:3111\\b",
      "url": "http://localhost:3111",
      "label": "localhost:3111"
    },
    {
      "type": "regex",
      "pattern": "http://localhost:3821\\b",
      "url": "http://localhost:3821",
      "label": "localhost:3821"
    },
    {
      "type": "regex",
      "pattern": "http://localhost:5173\\b",
      "url": "http://localhost:5173",
      "label": "localhost:5173"
    },
    {
      "type": "regex",
      "pattern": "http://localhost:8080\\b",
      "url": "http://localhost:8080",
      "label": "localhost:8080"
    },
    {
      "type": "regex",
      "pattern": "https://github\\.com/(?<owner>[\\w.-]+)/(?<repo>[\\w.-]+)/actions/runs/(?<id>\\d+)",
      "url": "https://github.com/{owner}/{repo}/actions/runs/{id}",
      "label": "run {id}"
    }
  ],
  "terminalProgressBarEnabled": true,
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    },
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "enableWorkflows": true,
  "alwaysThinkingEnabled": true,
  "skipWorkflowUsageWarning": true
}
