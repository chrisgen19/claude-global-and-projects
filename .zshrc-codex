# Codex: always use sandboxed automatic approval review.
# --no-daemon keeps hooks under this tab's codex process, which the tab-status
# hooks need to find their tty (see README "Tab status hooks").
# Add this block to ~/.zshrc before the Powerlevel10k theme, if present.
# Pass the flags to resume/fork too, overriding a saved manual approval mode.
codex() {
  # next-steps: ctrl+g on an empty prompt offers the suggested next prompts.
  local -x NEXT_STEPS_EDITOR="${NEXT_STEPS_EDITOR:-${VISUAL:-$EDITOR}}"
  local -x VISUAL=next-steps-editor NEXT_STEPS_TOOL=codex
  case "${1-}" in
    resume|fork)
      command codex "$1" --approve-for-me --no-daemon "${@:2}"
      ;;
    *)
      command codex --approve-for-me --no-daemon "$@"
      ;;
  esac
}

# Restore terminal modes after TUIs: codex can exit (e.g. on ctrl+c) without
# turning off kitty keyboard protocol and mouse tracking, which leaves `9;5u`
# and `35;142;16M` garbage at the prompt. Turn both off before every prompt.
_reset_tui_modes() { printf '\e[<u\e[?1000l\e[?1002l\e[?1003l\e[?1006l' }
autoload -Uz add-zsh-hook
add-zsh-hook precmd _reset_tui_modes
