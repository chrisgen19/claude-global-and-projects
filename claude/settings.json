{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 60
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh busy",
            "async": true,
            "statusMessage": "tab status: busy"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh busy",
            "async": true,
            "statusMessage": "tab status: busy"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/token_profiler.py hook PostToolUse",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh busy",
            "async": true,
            "statusMessage": "tab status: busy"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh busy",
            "async": true,
            "statusMessage": "tab status: busy"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh done",
            "async": true,
            "statusMessage": "tab status: done"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh done",
            "async": true,
            "statusMessage": "tab status: done"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/token_profiler.py hook Stop",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh reset",
            "statusMessage": "tab status: reset"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh reset",
            "statusMessage": "tab status: reset"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh waiting",
            "statusMessage": "tab status: waiting"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh waiting",
            "statusMessage": "tab status: waiting"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh reset",
            "statusMessage": "tab status: reset"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh reset",
            "statusMessage": "tab status: reset"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh reset",
            "statusMessage": "tab status: reset"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh reset",
            "statusMessage": "tab status: reset"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/token_profiler.py hook SessionEnd",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.local/bin/prisma-prod-guard",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); if printf '%s' \"$cmd\" | grep -qF -e '2>&1' -e '2>/dev/null'; then printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Command contains 2>&1 or 2>/dev/null, which are disallowed per your global CLAUDE.md. Rewrite the command without stderr redirection.\"}}'; fi",
            "statusMessage": "Checking for disallowed stderr redirection"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/token_profiler.py hook SubagentStop",
            "async": true
          }
        ]
      }
    ]
  },
  "footerLinksRegexes": [
    {
      "type": "regex",
      "pattern": "http://localhost:3000\\b",
      "url": "http://localhost:3000",
      "label": "localhost:3000"
    },
    {
      "type": "regex",
      "pattern": "http://localhost:3001\\b",
      "url": "http://localhost:3001",
      "label": "localhost:3001"
    },
    {
      "type": "regex",
      "pattern": "http://localhost:3020\\b",
      "url": "http://localhost:3020",
      "label": "localhost:3020"
    },
    {
      "type": "regex",
      "pattern": "http://localhost:3111\\b",
      "url": "http://localhost:3111",
      "label": "localhost:3111"
    },
    {
      "type": "regex",
      "pattern": "http://localhost:3821\\b",
      "url": "http://localhost:3821",
      "label": "localhost:3821"
    },
    {
      "type": "regex",
      "pattern": "http://localhost:5173\\b",
      "url": "http://localhost:5173",
      "label": "localhost:5173"
    },
    {
      "type": "regex",
      "pattern": "http://localhost:8080\\b",
      "url": "http://localhost:8080",
      "label": "localhost:8080"
    },
    {
      "type": "regex",
      "pattern": "https://github\\.com/(?<owner>[\\w.-]+)/(?<repo>[\\w.-]+)/actions/runs/(?<id>\\d+)",
      "url": "https://github.com/{owner}/{repo}/actions/runs/{id}",
      "label": "run {id}"
    }
  ],
  "terminalProgressBarEnabled": true,
  "enabledPlugins": {
    "next-steps@claude-community": true
  },
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  }
}
