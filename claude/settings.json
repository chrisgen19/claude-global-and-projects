{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "footerLinksRegexes": [
    {
      "label": "localhost:3000",
      "pattern": "http://localhost:3000\\b",
      "type": "regex",
      "url": "http://localhost:3000"
    },
    {
      "label": "localhost:3001",
      "pattern": "http://localhost:3001\\b",
      "type": "regex",
      "url": "http://localhost:3001"
    },
    {
      "label": "localhost:3020",
      "pattern": "http://localhost:3020\\b",
      "type": "regex",
      "url": "http://localhost:3020"
    },
    {
      "label": "localhost:3111",
      "pattern": "http://localhost:3111\\b",
      "type": "regex",
      "url": "http://localhost:3111"
    },
    {
      "label": "localhost:3821",
      "pattern": "http://localhost:3821\\b",
      "type": "regex",
      "url": "http://localhost:3821"
    },
    {
      "label": "localhost:5173",
      "pattern": "http://localhost:5173\\b",
      "type": "regex",
      "url": "http://localhost:5173"
    },
    {
      "label": "localhost:8080",
      "pattern": "http://localhost:8080\\b",
      "type": "regex",
      "url": "http://localhost:8080"
    },
    {
      "label": "run {id}",
      "pattern": "https://github\\.com/(?<owner>[\\w.-]+)/(?<repo>[\\w.-]+)/actions/runs/(?<id>\\d+)",
      "type": "regex",
      "url": "https://github.com/{owner}/{repo}/actions/runs/{id}"
    }
  ],
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "bash ~/.vibemon/notify.sh permission claude_code",
            "statusMessage": "vibemon: permission",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh waiting",
            "statusMessage": "tab status: waiting",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.vibemon/notify.sh activity claude_code",
            "statusMessage": "vibemon: activity",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|NotebookEdit|Task"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.vibemon/notify.sh bash claude_code",
            "statusMessage": "vibemon: bash",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh busy",
            "statusMessage": "tab status: busy",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "bash ~/.vibemon/notify.sh tool_failure claude_code",
            "statusMessage": "vibemon: tool_failure",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|NotebookEdit|Task"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.vibemon/notify.sh tool_failure claude_code",
            "statusMessage": "vibemon: tool_failure",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash ~/.vibemon/notify.sh session_end claude_code",
            "statusMessage": "vibemon: session_end",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh reset",
            "statusMessage": "tab status: reset",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.vibemon/notify.sh session_start claude_code",
            "statusMessage": "vibemon: session_start",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh reset",
            "statusMessage": "tab status: reset",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash ~/.vibemon/notify.sh stop claude_code",
            "statusMessage": "vibemon: stop",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh done",
            "statusMessage": "tab status: done",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash ~/.vibemon/notify.sh prompt claude_code",
            "statusMessage": "vibemon: prompt",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh busy",
            "statusMessage": "tab status: busy",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -x ~/.config/iterm2/cc-status ] || exit 0; exec ~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 60,
    "type": "command"
  },
  "terminalProgressBarEnabled": true
}
