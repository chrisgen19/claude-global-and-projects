{
  "description": "Tab status indicator (iTerm2 / Windows Terminal). Only works under `codex --no-daemon`: daemon-spawned hooks have no tty to find (openai/codex#37537). Plus next-steps: suggested next prompts, picked with ctrl+g (see README \"next-steps for Codex and agy\").",
  "hooks": {
    "Interrupt": [
      {
        "hooks": [
          {
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh reset",
            "timeout": 3,
            "type": "command"
          },
          {
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh reset",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh waiting",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh waiting",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh busy",
            "timeout": 10,
            "type": "command"
          },
          {
            "async": true,
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh busy",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh reset",
            "timeout": 3,
            "type": "command"
          },
          {
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh reset",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh reset",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh reset",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear)$"
      },
      {
        "hooks": [
          {
            "command": "[ -f ~/.codex/herdr-agent-state.sh ] || exit 0; exec bash ~/.codex/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh done",
            "timeout": 10,
            "type": "command"
          },
          {
            "async": true,
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh done",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.local/bin/next-steps codex-stop",
            "timeout": 180,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "async": true,
            "command": "bash ~/.local/bin/claude-iterm-tab-status.sh busy",
            "timeout": 10,
            "type": "command"
          },
          {
            "async": true,
            "command": "bash ~/.local/bin/claude-wt-tab-status.sh busy",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.local/bin/next-steps codex-prompt",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
